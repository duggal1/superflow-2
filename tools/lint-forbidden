#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
violations=0
ui_roots=("$repo_root/Packages" "$repo_root/App/SuperflowApp" "$repo_root/App/InferenceHelper")
glob=(--glob '*.swift' --glob '!**/.build/**')

report_matches() {
    local pattern="$1"
    local message="$2"
    local matches
    shift 2
    matches="$(rg -n "${glob[@]}" "$pattern" "$@" || true)"
    if [[ -n "$matches" ]]; then
        printf '%s\n%s\n' "$message" "$matches" >&2
        violations=$((violations + 1))
    fi
}

report_outside() {
    local pattern="$1"
    local allowed="$2"
    local message="$3"
    local matches
    local filtered
    shift 3
    matches="$(rg -n "${glob[@]}" "$pattern" "$@" || true)"
    filtered="$(printf '%s\n' "$matches" | rg -v "$allowed" || true)"
    if [[ -n "${filtered//$'\n'/}" ]]; then
        printf '%s\n%s\n' "$message" "$filtered" >&2
        violations=$((violations + 1))
    fi
}

while IFS= read -r -d '' source; do
    lines="$(wc -l < "$source")"
    if (( lines > 400 )); then
        printf 'Swift source exceeds 400 lines (%s): %s\n' "$lines" "$source" >&2
        violations=$((violations + 1))
    fi
done < <(find "$repo_root/Packages" "$repo_root/App/SuperflowApp" "$repo_root/App/InferenceHelper" -path '*/.build' -prune -o -path '*/Sources/*' -name '*.swift' -print0)

report_matches '\bprint\s*\(' 'Use structured logging instead of print().' "${ui_roots[@]}"

# Feature packages compose shared components; they never build raw controls.
report_matches '\b(Button|Toggle|Picker|Slider|Stepper|TextField)\s*\(|onTapGesture|NSCursor' \
    'Feature packages must use shared interactive components and may not manage cursors directly.' \
    "$repo_root/Packages/L3-Features"

report_outside '\.pointerStyle' "UIComponents/Sources/SuperflowUIComponents/Pointer\.swift:" \
    'The pointer hand is only available through clickable().' "${ui_roots[@]}"

# R2: no strokes anywhere except the focus ring, Increase Contrast, and the
# single button edge the button spec defines.
report_outside '\.(stroke|strokeBorder|border)\(' \
    "DesignSystem/Sources/SuperflowDesignSystem/Surfaces\.swift:|UIComponents/Sources/SuperflowUIComponents/Buttons\.swift:|UIComponents/Sources/SuperflowUIComponents/FocusStep\.swift:" \
    'Strokes are only allowed in ContrastStroke, focusRing and FocusStep.' "${ui_roots[@]}"

# R2: no dividers. Spacing and fills do that job.
report_matches '\bDivider\(\)' \
    'Dividers are forbidden; separate with spacing and surface steps.' "${ui_roots[@]}"

# R3: one icon family, one implementation.
report_outside 'Image\(systemName:' "Icons/Sources/SuperflowIcons/Glyph\.swift:" \
    'Use the shared Icon view instead of Image(systemName:).' "${ui_roots[@]}"

# R4: colours come from the token file; canvas ramps are the only exceptions.
report_outside 'Color\(hex:' \
    "(DesignSystem/Sources/SuperflowDesignSystem/|UIComponents/Sources/SuperflowUIComponents/(PixelStop|PixelField)\.swift:)" \
    'Hex colours belong in DesignSystem tokens (canvas ramps excepted).' "${ui_roots[@]}"

# R5: Regular and Medium only.
report_matches 'weight:\s*\.(bold|semibold|heavy|black)\b|fontWeight\(\.(bold|semibold|heavy|black)\)' \
    'Font weights heavier than .medium are forbidden.' "${ui_roots[@]}"

# R5: fixed font sizes must come from the type table.
allowed_sizes=(9 10 11 12 13 14 15 16 28 40)
while IFS= read -r match; do
    [[ -z "$match" ]] && continue
    size="$(printf '%s' "$match" | sed -E 's/.*size: ([0-9]+).*/\1/')"
    ok=0
    for allowed in "${allowed_sizes[@]}"; do
        if [[ "$size" == "$allowed" ]]; then ok=1; break; fi
    done
    if (( ok == 0 )); then
        printf 'Font size %s is outside the type table: %s\n' "$size" "$match" >&2
        violations=$((violations + 1))
    fi
done < <(rg -n -o "\.system\(size: [0-9]+" "${glob[@]}" "${ui_roots[@]}" || true)

# R7: nothing bounces, loops, or moves linearly.
report_matches '\.animation\(\.linear|\.easeInOut|\.spring\(|\.bouncy' \
    'Only the motion tokens (easeOut, settle, snappy, smooth) are allowed.' "${ui_roots[@]}"

report_matches 'import .*(Hugeicons|Phosphor)|HugeIcon' \
    'Third-party icon families are removed; use Glyph.' "${ui_roots[@]}"

# Pass 2 structure: the system chrome is deleted, not restyled.
report_matches 'NavigationSplitView|NavigationStack|\.searchable\(|\.toolbar \{|\.toolbar\{|\.toolbar\(removing:|ToolbarItem|toolbarBackgroundVisibility' \
    'The shell is a custom HStack with PageBar and SearchField. System split views, toolbars and .searchable are deleted.' \
    "$repo_root/Packages/L3-Features" "$repo_root/Packages/L4-UI" \
    "$repo_root/App/SuperflowApp/Sources/SuperflowAppCore/Windowing"

report_matches '\.popover\(' \
    'Menus and dropdowns render in MenuLayer. No .popover anywhere.' "${ui_roots[@]}"

report_matches '\bTimingSlider\b' \
    'TimingSlider is deleted. Use AppSlider (pass 3).' "${ui_roots[@]}"

report_outside '(^|[^A-Za-z])Slider\(' "UIComponents/Sources/SuperflowUIComponents/Sliders\.swift:" \
    'Sliders are AppSlider. The native Slider is allowed only inside AppSlider (VoiceOver).' "${ui_roots[@]}"

report_outside 'isMovableByWindowBackground = true' \
    "UIComponents/Sources/SuperflowUIComponents/Chrome\.swift:" \
    'The main window drags from WindowDragArea. Only onboarding moves by background.' "${ui_roots[@]}"

report_matches '\.symbolRenderingMode\(\.hierarchical\)' \
    'Icons render monochrome, so a parent foregroundStyle reaches them.' "${ui_roots[@]}"

report_outside 'NSCursor' "UIComponents/Sources/SuperflowUIComponents/Pointer\.swift:" \
    'Cursors live in clickable(), backed by CursorRect.' "${ui_roots[@]}"

report_matches '(^|[^A-Za-z])Menu[[:space:]]*[\{(]' \
    'Native menus are replaced by ActionMenu in page bars.' "$repo_root/Packages/L3-Features" "$repo_root/App/SuperflowApp"

# The system focus ring is the sky-blue border the owner rejected.
while IFS= read -r file; do
    if rg -q '\.focusable\(' "$file" && ! rg -q '\.focusEffectDisabled\(' "$file"; then
        printf '.focusable() without .focusEffectDisabled(): %s\n' "$file" >&2
        violations=$((violations + 1))
    fi
done < <(rg -l '\.focusable\(' "${glob[@]}" "${ui_roots[@]}" || true)

# Icon sizes are exactly 14 (rows), 16 (bar), 12 (buttons), 9 (chevron).
while IFS= read -r match; do
    [[ -z "$match" ]] && continue
    size="$(printf '%s' "$match" | sed -E 's/.*size: ([0-9]+).*/\1/')"
    case "$size" in
        9|12|14|16) ;;
        *)
            printf 'Icon size %s is outside 14 / 16 / 12 / 9: %s\n' "$size" "$match" >&2
            violations=$((violations + 1))
            ;;
    esac
done < <(rg -n -o '(^|[^A-Za-z])Icon\([^)]*size: [0-9]+' "${glob[@]}" \
    --glob '!**/FeatureOnboarding/**' --glob '!**/FeatureIsland/**' \
    "$repo_root/Packages/L3-Features" "$repo_root/Packages/L4-UI" \
    "$repo_root/App/SuperflowApp" || true)

# Pass 3 additions.
report_matches '\bfocusRing\(' 'focusRing is deleted; use keyboardFocusRing.' "${ui_roots[@]}"

# .focusable without .focusEffectDisabled in same file (already handled above).

report_matches '\bProgressRow\b' 'ProgressRow is deleted; use DownloadCard.' "${ui_roots[@]}"
report_matches '\bContributionGrid\(' 'ContributionGrid view is deleted; use ActivityYear.' "${ui_roots[@]}"
report_matches 'ContributionGrid\.ramp' 'Use Ramp.blue instead of ContributionGrid.ramp.' "${ui_roots[@]}"

report_matches '\bClearKey\b' 'ClearKey replaced by ShellKey.' "${ui_roots[@]}"

# .pointerStyle outside clickable() and scrubbable()
# (already enforced for clickable only; extend allowed list)
# handled by report_outside below
report_outside '\.pointerStyle' "UIComponents/Sources/SuperflowUIComponents/Pointer\.swift:"     'pointerStyle is only available through clickable() and scrubbable().' "${ui_roots[@]}"

report_matches '\bPicker\b|\.pickerStyle\(' 'No native Picker; use Dropdown.' "${ui_roots[@]}"

# Pass 3 type law: text comes from AppType, never a raw size. Monospaced faces
# and the icon family are the only exceptions.
report_outside '\.font\(\.system\(size:' \
    "AppType\.swift:|UIComponents/Sources/|Icons/Sources/|design: \.monospaced" \
    'Text size must come from AppType; only SF Mono (design: .monospaced) is exempt.' "${ui_roots[@]}"

# Pass 3 dialogs: no system sheets, alerts or confirmation dialogs.
report_matches '\.sheet\(|\.alert\(|\.confirmationDialog\(' \
    'Dialogs use DialogHost / DialogLayer. System sheets, alerts and confirmation dialogs are banned.' "${ui_roots[@]}"

# History has one date vocabulary.
report_matches '\.formatted\(date:|DateFormatter' \
    'History dates come from Humanize, never from a formatter.' \
    "$repo_root/Packages/L3-Features/FeatureHistory"

report_outside 'AVAudioPlayer' "UIComponents/Sources/SuperflowUIComponents/AudioPreview\.swift:" \
    'AVAudioPlayer lives only in the one shared audio preview.' "${ui_roots[@]}"
report_outside 'AVAudioFile\(forWriting' "AudioArchive\.swift:" \
    'Audio files are written only by AudioArchiveWriter.' "${ui_roots[@]}"

# Pass 3 settings rows all carry a glyph.
report_matches 'SettingRow\("' \
    'Every SettingRow takes a Glyph first (pass 3).' "${ui_roots[@]}"
report_matches 'help:' \
    'Help text is banned in Settings.' "$repo_root/Packages/L3-Features/FeatureSettings"

# The only white in the chrome is the toggle knob.
report_outside '(^|[^A-Za-z])Color\.white|\.fill\(\.white\)' \
    "UIComponents/Sources/SuperflowUIComponents/(Controls|Buttons)\.swift:" \
    'Raw white is allowed only for the toggle knob and primary button label.' "${ui_roots[@]}"
# Menu( and Menu { outside UIComponents
report_outside '(^|[^A-Za-z])Menu[[:space:]]*[\{(]' "UIComponents/Sources/SuperflowUIComponents/"     'Native menus are replaced by ActionMenu/Dropdown.' "${ui_roots[@]}"
report_matches '\.popover\(' 'No .popover; use MenuLayer.' "${ui_roots[@]}"

# Text buttons are 24 or 28 tall. Nothing else, anywhere.
report_matches 'height: ControlHeight\.onboardingCTA' \
    'Text buttons are 24, 28 or 32 tall.' "${ui_roots[@]}"
while IFS= read -r match; do
    [[ -z "$match" ]] && continue
    size="$(printf '%s' "$match" | sed -E 's/.*height: ([0-9]+).*/\1/')"
    case "$size" in
        24|28|32) ;;
        *)
            printf 'AppButton height %s is not 24, 28 or 32: %s\n' "$size" "$match" >&2
            violations=$((violations + 1))
            ;;
    esac
done < <(rg -n -o 'AppButton\([^)]*height: [0-9]+' "${glob[@]}" "${ui_roots[@]}" || true)

# accentPressed equal 0x1E40AF (blue 800 is removed from every control).
if rg -q --glob '*.swift' --glob '!**/.build/**' '0x1E40AF' "${ui_roots[@]}"; then
    printf 'accentPressed must be 0x1D4ED8, not 0x1E40AF.\n' >&2
    violations=$((violations + 1))
fi

# Route/AppSection list must contain models
if ! grep -R "\.models" "$repo_root/App/SuperflowApp/Sources/SuperflowAppCore/Windowing/MainWindowController.swift" >/dev/null 2>&1; then
    printf 'AppSection must contain .models.\n' >&2
    violations=$((violations + 1))
fi

# Image(" outside ModelMark: vendor art is bundled once and framed once.
report_outside 'Image\("' "FeatureSettings/Sources/SuperflowFeatureSettings/ModelsView.swift" \
    'Image(" is only allowed in ModelMark.' "${ui_roots[@]}"

# Pass 4: the Island is welded to the notch. It is hardware, not a material.
island_feature="$repo_root/Packages/L3-Features/FeatureIsland/Sources"
island_app=(
    "$repo_root/App/SuperflowApp/Sources/SuperflowAppCore/Windowing/IslandPanelController.swift"
    "$repo_root/App/SuperflowApp/Sources/SuperflowAppCore/IslandBridge.swift"
)

report_matches 'visibleFrame|GlassSurface|glassEffect\(|\.(ultraThin|thin|regular|thick|ultraThick)Material' \
    'The Island never uses visibleFrame or a material. It is opaque black at screen.frame.maxY.' \
    "$island_feature" "${island_app[@]}"

report_matches 'DragGesture|\.draggable\(|isMovableByWindowBackground = true' \
    'The Island is attached, never draggable.' "$island_feature" "${island_app[@]}"

report_outside 'setFrame\(' "IslandPanelController\.swift:" \
    'The Island window frame is set only by IslandController.place().' \
    "$island_feature" "${island_app[@]}"

report_outside 'NSWindow\.Level\(' "IslandPanelController\.swift:" \
    'The Island panel is the only window that raises its level.' \
    "$island_feature" "${island_app[@]}"

report_matches 'showIdlePill|"island\.origin|"island\.position' \
    'The idle pill and the persisted Island origin are deleted.' "$island_feature"

report_outside 'LinearGradient' "FeatureIsland/Sources/SuperflowFeatureIsland/EdgeFade\.swift:" \
    'A gradient is allowed only as EdgeFade'"'"'s text mask.' "$island_feature" "${island_app[@]}"

# Blur is a transition only, and 6 is its ceiling.
while IFS= read -r match; do
    [[ -z "$match" ]] && continue
    radius="$(printf '%s' "$match" | sed -E 's/.*radius: ([0-9]+).*/\1/')"
    if (( radius > 6 )); then
        printf 'Blur radius %s exceeds 6: %s\n' "$radius" "$match" >&2
        violations=$((violations + 1))
    fi
done < <(rg -n -o '\.blur\(radius: [0-9]+' "${glob[@]}" "$island_feature" "${island_app[@]}" || true)

# The old hardcoded panel sizes and glass radii must never come back.
while IFS= read -r match; do
    [[ -z "$match" ]] && continue
    printf 'Island size or radius is a literal from the deleted panel: %s\n' "$match" >&2
    violations=$((violations + 1))
done < <(rg -n '(width|height|top|bottom|radius|Radius)\s*[:=]\s*(280|460|22|26)([^0-9]|$)' \
    "${glob[@]}" "$island_feature" "${island_app[@]}" || true)

# Switches over IslandPhase are exhaustive; a `default` erases the compiler's
# check, so the two files that switch on it may not use one.
report_matches 'default:' \
    'Switches over IslandPhase must be exhaustive. No default: in the model or root view.' \
    "$island_feature/SuperflowFeatureIsland/IslandModel.swift" \
    "$island_feature/SuperflowFeatureIsland/IslandRoot.swift"

# Pass 3: one ring, and it is ours.
# Every file that makes a view focusable must also kill the system ring.
while IFS= read -r file; do
    [[ -z "$file" ]] && continue
    if ! grep -q 'focusEffectDisabled' "$file"; then
        printf 'A focusable view without focusEffectDisabled: %s\n' "$file" >&2
        violations=$((violations + 1))
    fi
done < <(rg -l '\.focusable\(' "$repo_root/Packages" "$repo_root/App/SuperflowApp" \
    --glob '!**/.build/**' || true)

# Event monitors have exactly three owners: the keyboard/pointer modality switch,
# the Island's outside-click monitors, and the onboarding fn demo.
report_outside 'NSEvent\.addLocalMonitorForEvents|NSEvent\.addGlobalMonitorForEvents' \
    "UIComponents/Sources/SuperflowUIComponents/InputModality\.swift:|IslandPanelController\.swift:|FeatureOnboarding/Sources/SuperflowFeatureOnboarding/FnDemo\.swift:" \
    'Event monitors live in InputModality, the Island panel and the onboarding fn demo.' \
    "$repo_root/Packages" "$repo_root/App/SuperflowApp"

if (( violations > 0 )); then
    printf 'Forbidden-pattern lint found %d violation(s).\n' "$violations" >&2
    exit 1
fi

printf '%s\n' 'Forbidden-pattern lint passed.'
