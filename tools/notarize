#!/bin/bash
# Developer ID sign, notarize and staple a Superflow.app (and its DMG).
#
# Requires a Developer ID Application identity in the login keychain and a
# notarytool keychain profile created with:
#   xcrun notarytool store-credentials "$SUPERFLOW_NOTARY_PROFILE" \
#       --apple-id <id> --team-id <TEAMID> --password <app-specific-password>
#
# Inputs / env:
#   SUPERFLOW_APP_PATH       app bundle (default dist/Superflow.app)
#   SUPERFLOW_DMG_PATH       DMG to notarize too (default dist/Superflow.dmg if present)
#   SUPERFLOW_SIGN_IDENTITY  "Developer ID Application: Name (TEAMID)" (required)
#   SUPERFLOW_NOTARY_PROFILE notarytool keychain profile (default superflow-notary)
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP="${SUPERFLOW_APP_PATH:-$ROOT/dist/Superflow.app}"
DMG="${SUPERFLOW_DMG_PATH:-$ROOT/dist/Superflow.dmg}"
IDENTITY="${SUPERFLOW_SIGN_IDENTITY:-}"
PROFILE="${SUPERFLOW_NOTARY_PROFILE:-superflow-notary}"
ENTITLEMENTS="$ROOT/App/Resources/Superflow.entitlements"

if [[ -z "$IDENTITY" ]]; then
    printf 'Set SUPERFLOW_SIGN_IDENTITY to your Developer ID Application identity.\n' >&2
    exit 2
fi
if [[ ! -d "$APP" ]]; then
    printf 'No app bundle at %s. Run `make app` first.\n' "$APP" >&2
    exit 2
fi

# Sign inside out: nested helpers/frameworks first, then the bundle itself.
find "$APP/Contents" -depth \( -name "*.app" -o -name "*.framework" -o -name "*.dylib" \) -print0 |
    while IFS= read -r -d '' item; do
        codesign --force --timestamp --options runtime --sign "$IDENTITY" "$item"
    done

codesign --force --timestamp --options runtime \
    --entitlements "$ENTITLEMENTS" --sign "$IDENTITY" "$APP"
codesign --verify --deep --strict --verbose=2 "$APP"

notarize() {
    local target="$1"
    xcrun notarytool submit "$target" --keychain-profile "$PROFILE" --wait
    xcrun stapler staple "$target"
}

notarize "$APP"

if [[ -f "$DMG" ]]; then
    codesign --force --timestamp --sign "$IDENTITY" "$DMG"
    notarize "$DMG"
fi

printf 'Signed and notarized %s\n' "$APP"
spctl --assess --type execute --verbose=2 "$APP"
