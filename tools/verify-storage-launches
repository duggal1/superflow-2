#!/usr/bin/env python3
"""Launch the real app against disposable storage; never touch the user's library."""
import argparse
import os
import pathlib
import signal
import sqlite3
import subprocess
import sys
import tempfile
import time

parser = argparse.ArgumentParser()
parser.add_argument('executable', type=pathlib.Path)
parser.add_argument('--runs', type=int, default=25)
args = parser.parse_args()
executable = args.executable.resolve()
writer_source = '''
import sqlite3, sys, time
c = sqlite3.connect(sys.argv[1])
c.execute('PRAGMA cache_size=10')
c.execute('CREATE TABLE IF NOT EXISTS durability_probe (id INTEGER PRIMARY KEY, payload BLOB)')
c.execute('INSERT INTO durability_probe(payload) VALUES (?)', (b'committed',))
c.commit()
c.execute('BEGIN IMMEDIATE')
c.execute('INSERT INTO durability_probe(payload) VALUES (zeroblob(8388608))')
print('uncommitted write spilled', flush=True)
time.sleep(60)
'''
with tempfile.TemporaryDirectory(prefix='superflow-launch-proof-') as root:
    directory = pathlib.Path(root) / 'missing' / 'nested'
    database = directory / 'Superflow.sqlite'
    for iteration in range(args.runs):
        with tempfile.TemporaryFile() as output:
            app = subprocess.Popen([str(executable), '--application-support-directory', str(directory)],
                                   stdout=output, stderr=output)
            writer = None
            try:
                deadline = time.monotonic() + 15
                while time.monotonic() < deadline:
                    if app.poll() is not None:
                        output.seek(0)
                        raise RuntimeError(f'app exited {app.returncode}: {output.read().decode(errors="replace")}')
                    opened = subprocess.run(['/usr/sbin/lsof', '-a', '-p', str(app.pid), str(database)],
                                            capture_output=True).returncode == 0
                    if opened:
                        with sqlite3.connect(database) as connection:
                            if connection.execute('PRAGMA user_version').fetchone()[0] == 3:
                                break
                    time.sleep(0.1)
                else:
                    raise RuntimeError('app did not open and migrate its database')
                duplicate = subprocess.run([str(executable), '--application-support-directory', str(directory)],
                                           capture_output=True, timeout=15)
                assert duplicate.returncode == 0, duplicate.stderr
                writer = subprocess.Popen([sys.executable, '-u', '-c', writer_source, str(database)],
                                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
                assert writer.stdout.readline().strip() == 'uncommitted write spilled'
                app.kill()
                app.wait(timeout=10)
                writer.kill()
                writer.wait(timeout=10)
                with sqlite3.connect(database) as connection:
                    assert connection.execute('PRAGMA quick_check').fetchone() == ('ok',)
                    rows = connection.execute('SELECT count(*) FROM durability_probe').fetchone()[0]
                    assert rows == iteration + 1, (rows, iteration + 1)
                assert not list(directory.glob('Superflow-corrupt-*'))
                print(f'launch {iteration + 1}/{args.runs}: DB opened; duplicate rejected; killed during WAL write; {rows} committed rows preserved', flush=True)
            finally:
                for process in (writer, app):
                    if process is not None and process.poll() is None:
                        process.kill()
                        process.wait()
    print(f'PASS: {args.runs} app launches, zero DB errors, committed history preserved')
